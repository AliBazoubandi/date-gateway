# Copy this file to config/.env and fill in real values.
# config/.env is gitignored — secrets must never be committed.

# Master key for AES-256-GCM (connection passwords, per-call download tokens).
# 64 hex chars. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Changing it makes every previously stored secret unreadable.
GATEWAY_MASTER_KEY=

# Metadata database password (the dedicated user - create it once with
# sql/create_user.sql, which sets up 'gateway' with the needed grants;
# override the username here only if you chose a different one).
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=

# Public base URL used to build download links and identify the mount prefix.
# Examples:
#   Local vhost:   http://gw.internal
#   Server subpath: https://rbb.palood.ir/gateway
# Must be a valid http(s) URL; https is required in production (GATEWAY_DEBUG=0).
# Leave empty only on development machines (GATEWAY_DEBUG=1), where links are
# built from the incoming Host header. cli/check.php FAILS while this is empty.
GATEWAY_BASE_URL=

# Optional: explicit subpath prefix override (e.g. /gateway).
# Leave empty to automatically infer from GATEWAY_BASE_URL.
# GATEWAY_BASE_PATH=

# Reverse proxies / load balancers in front of the application (e.g. Nginx).
# When set, X-Forwarded-For is trusted from these IPs for client rate-limiting and audit.
# Example: 127.0.0.1, ::1
# GATEWAY_TRUSTED_PROXIES=

# 1 = show PHP errors in the browser (development only; never in production).
GATEWAY_DEBUG=0

