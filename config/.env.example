# Copy this file to config/.env and fill in real values.
# config/.env is gitignored — secrets must never be committed.

# Master key for AES-256-GCM (connection passwords, per-call download tokens).
# 64 hex chars. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# Changing it makes every previously stored secret unreadable.
GATEWAY_MASTER_KEY=

# Metadata database password (the dedicated user - create it once with
# sql/create_user.sql, which sets up 'gateway' with the needed grants;
# override the username here only if you chose a different one).
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=

# Public base URL used to build download links, e.g. https://gw.internal.
# Leave empty to build from the incoming Host header.
GATEWAY_BASE_URL=

# 1 = show PHP errors in the browser (development only; never in production).
GATEWAY_DEBUG=0
