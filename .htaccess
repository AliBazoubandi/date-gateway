# Deny everything under the project root. Apache's DocumentRoot must point at
# public/, whose own .htaccess re-enables access. This is the safety net for a
# misconfigured vhost that accidentally serves the project root.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
